import math

# Polynomial least-squares fitting
def fit(x, y, degree):
    n = degree + 1
    A = [[sum(v**(i+j) for v in x) for j in range(n)]
         for i in range(n)]
    B = [sum(y[k]*x[k]**i for k in range(len(x)))
         for i in range(n)]

    for i in range(n):
        p = A[i][i]
        for j in range(i, n):
            A[i][j] /= p
        B[i] /= p

        for k in range(n):
            if k != i:
                p = A[k][i]
                for j in range(i, n):
                    A[k][j] -= p*A[i][j]
                B[k] -= p*B[i]

    return B[::-1]

def poly(p, x):
    y = 0
    for a in p:
        y = y*x+a
    return y

