# Q9: Taylor series of exp(x)
def exp_taylor(x,n):
    return sum(x**k/math.factorial(k) for k in range(n+1))

print("\nQ9:")
for n in [2,3,5,10]:
    v = exp_taylor(.5,n)
    print(n,v,abs(math.exp(.5)-v))

# Q10: Taylor series of sin(x)
def sin_taylor(x,n):
    return sum((-1)**k*x**(2*k+1)/math.factorial(2*k+1)
               for k in range(n))

print("\nQ10:")
for n in [1,2,3,4]:
    v = sin_taylor(math.pi/4,n)
    print(2*n-1,v,abs(math.sin(math.pi/4)-v))

# Q11: Taylor series of ln(x) about 1
def ln_taylor(x,n):
    return sum((-1)**(k+1)*(x-1)**k/k for k in range(1,n+1))

print("\nQ11:")
for x in [1.2,1.5,2]:
    v = ln_taylor(x,4)
    print(x,v,abs(math.log(x)-v))

# Q12: Taylor series of cos(x)
def cos_taylor(x,n):
    return sum((-1)**k*x**(2*k)/math.factorial(2*k)
               for k in range(n))

print("\nQ12:")
for x in [.5,1,1.5,2,2.5]:
    for n in [2,4,6,8]:
        v = cos_taylor(x,n)
        print(x,n,v,abs(math.cos(x)-v))
