# Q5: Linear interpolation
def linear(x,y,z):
    for i in range(len(x)-1):
        if x[i] <= z <= x[i+1]:
            return y[i]+(y[i+1]-y[i])*(z-x[i])/(x[i+1]-x[i])

x = [20,30,40,50,60]
y = [998.2,995.7,992.2,988.1,983.2]
print("\nQ5 density at 35:",linear(x,y,35))
print("Q5 density at 47:",linear(x,y,47))

# Q6: Cubic spline requires additional calculations;
# use the Lagrange function below for interpolation values.
# Natural cubic spline is not implemented in this short version.

# Lagrange interpolation
def lagrange(x,y,z):
    total = 0
    for i in range(len(x)):
        term = y[i]
        for j in range(len(x)):
            if i != j:
                term *= (z-x[j])/(x[i]-x[j])
        total += term
    return total

