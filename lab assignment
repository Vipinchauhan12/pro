import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# Q1: Linear regression
def q1():
    x=np.arange(0,11,2); y=[82,74,67,59,52,45]
    p=np.polyfit(x,y,1)
    print("Q1:",p,"T(5)=",np.polyval(p,5))
    plt.scatter(x,y); plt.plot(x,np.polyval(p,x)); plt.show()

# Q2: Exponential regression
def q2():
    t=np.arange(0,11,2); c=[10.2,8.1,6.6,5.4,4.7,3.5]
    b,A=np.polyfit(t,np.log(c),1); a=np.exp(A)
    print("Q2: C(t)=",a,"exp(",b,"t), C(5)=",a*np.exp(5*b))
    z=np.linspace(0,10,100)
    plt.scatter(t,c); plt.plot(z,a*np.exp(b*z)); plt.show()

# Q3: Quadratic regression
def q3():
    t=np.arange(6); y=[2.1,7.8,11.9,14.4,16.1,14.2]
    p=np.polyfit(t,y,2)
    print("Q3:",p,"y(3.8)=",np.polyval(p,3.8))
    z=np.linspace(0,5,100)
    plt.scatter(t,y); plt.plot(z,np.polyval(p,z)); plt.show()

# Q4: Polynomial regression degrees 1-4
def q4():
    t=np.arange(7); y=[1.2,2.8,5.1,8.9,13.2,18.5,25.1]
    z=np.linspace(0,6,100); plt.scatter(t,y)
    for n in range(1,5):
        p=np.polyfit(t,y,n)
        print(n,"coefficients:",p,"y(1.3):",np.polyval(p,1.3))
        plt.plot(z,np.polyval(p,z),label=str(n))
    plt.legend(); plt.show()

# Q5: Linear interpolation
def q5():
    x=[20,30,40,50,60]; y=[998.2,995.7,992.2,988.1,983.2]
    print("Q5:",np.interp([35,47],x,y))
    z=np.linspace(20,60,100)
    plt.scatter(x,y); plt.plot(z,np.interp(z,x,y)); plt.show()

# Q6: Natural cubic spline
def q6():
    x=np.arange(6); y=[1,1.8,2.5,2,3.5,4.1]
    s=CubicSpline(x,y,bc_type="natural")
    print("Q6:",s([1.5,2.5,3.5]))
    z=np.linspace(0,5,100)
    plt.scatter(x,y); plt.plot(z,s(z)); plt.show()

# Q7: Lagrange interpolation
def lagrange(x,y,z):
    return sum(y[i]*np.prod([(z-x[j])/(x[i]-x[j])
        for j in range(len(x)) if i!=j],axis=0)
        for i in range(len(x)))

def q7():
    x=np.array([0,1,2,3,4]); y=np.array([1,3,2,5,4])
    print("Q7:",lagrange(x,y,np.array([2.5,3.6])))
    z=np.linspace(0,4,100)
    plt.scatter(x,y); plt.plot(z,lagrange(x,y,z)); plt.show()

# Q8: Runge function interpolation
def q8():
    f=lambda x: 1/(1+25*x**2)
    x=np.array([-1,-.75,-.5,-.25,.25,.5,.75,1])
    y=f(x); z=np.linspace(-1,1,300)
    plt.plot(z,f(z),label="Exact")
    plt.plot(z,np.interp(z,x,y),label="Linear")
    plt.plot(z,lagrange(x,y,z),label="Lagrange")
    plt.plot(z,CubicSpline(x,y,bc_type="natural")(z),label="Spline")
    plt.scatter(x,y); plt.legend(); plt.show()

# Q9: Taylor series for exp(x)
def q9():
    x=.5
    for n in [1,2,3,5,10]:
        p=sum(x**k/np.math.factorial(k) for k in range(n+1))
        print(n,p,abs(np.exp(x)-p))

# Q10: Taylor series for sin(x)
def q10():
    x=np.pi/4
    for n in [1,3,5,7]:
        p=sum((-1)**k*x**(2*k+1)/np.math.factorial(2*k+1)
              for k in range(n))
        print(n,p,abs(np.sin(x)-p))
    z=np.linspace(-np.pi,np.pi,300)
    plt.plot(z,np.sin(z),label="Exact")
    for n in [1,3,5,7]:
        plt.plot(z,sum((-1)**k*z**(2*k+1)/np.math.factorial(2*k+1)
                       for k in range(n)),label=str(n))
    plt.legend(); plt.grid(); plt.show()

# Q11: Taylor series for ln(x), about x=1
def q11():
    for x in [1.2,1.5,2]:
        p=sum((-1)**(k+1)*(x-1)**k/k for k in range(1,5))
        print(x,p,abs(np.log(x)-p))

# Q12: Taylor series for cos(x)
def q12():
    for x in [.5,1,1.5,2,2.5]:
        for n in [2,4,6,8]:
            p=sum((-1)**k*x**(2*k)/np.math.factorial(2*k)
                  for k in range(n))
            print(x,n,p,abs(np.cos(x)-p))
    z=np.linspace(-np.pi,np.pi,300)
    plt.plot(z,np.cos(z),label="Exact")
    for n in [2,4,6,8]:
        plt.plot(z,sum((-1)**k*z**(2*k)/np.math.factorial(2*k)
                       for k in range(n)),label=str(n))
    plt.legend(); plt.grid(); plt.show()

for f in [q1,q2,q3,q4,q5,q6,q7,q8,q9,q10,q11,q12]:
    f()
